{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "InternalAuth": {
    "SecretKey": "moneytracker-internal-gateway-secret-key"
  },
  "OpenApi": {
    "Title": "MoneyTracker API Gateway",
    "ServerUrl": "http://localhost:5016",
    "Documents": [
      {
        "Name": "gateway",
        "Title": "Gateway & Identity (Auth)",
        "RoutePattern": "/openapi/v1.json",
        "IsDefault": true
      },
      {
        "Name": "moneytracker",
        "Title": "Money Tracker Service",
        "RoutePattern": "/openapi/services/moneytracker.json"
      },
      {
        "Name": "investment",
        "Title": "Investment Service",
        "RoutePattern": "/openapi/services/investment.json"
      }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "money_tracker_openapi": {
        "ClusterId": "money_tracker",
        "Match": {
          "Path": "openapi/services/moneytracker.json"
        },
        "Transforms": [
          { "PathPattern": "/openapi/v1.json" }
        ]
      },
      "investment_openapi": {
        "ClusterId": "investment",
        "Match": {
          "Path": "openapi/services/investment.json"
        },
        "Transforms": [
          { "PathPattern": "/openapi.json" }
        ]
      },
      "indices_v1": {
        "ClusterId": "investment",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "api/v1/indices/{**catch-all}",
          "Methods": ["GET"]
        }
      },
      "funds_v1": {
        "ClusterId": "investment",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "api/v1/funds/{**catch-all}",
          "Methods": ["GET"]
        }
      },
      "investment_system": {
        "ClusterId": "investment",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "investment",
          "Methods": ["GET"]
        },
        "Transforms": [
          { "PathPattern": "/" }
        ]
      },
      "investment_health": {
        "ClusterId": "investment",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "investment/health",
          "Methods": ["GET"]
        },
        "Transforms": [
          { "PathPattern": "/health" }
        ]
      },
      "investment_clear_cache": {
        "ClusterId": "investment",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "investment/cache/clear",
          "Methods": ["POST"]
        },
        "Transforms": [
          { "PathPattern": "/cache/clear" }
        ]
      },
      "money_tracker_currency": {
        "ClusterId": "money_tracker",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "api/Currency/{**catch-all}"
        }
      },
      "money_tracker_expense_categories": {
        "ClusterId": "money_tracker",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "api/expense-categories/{**catch-all}"
        }
      },
      "money_tracker_expenses": {
        "ClusterId": "money_tracker",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "api/Expense/{**catch-all}"
        }
      },
      "money_tracker_income_categories": {
        "ClusterId": "money_tracker",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "api/income-categories/{**catch-all}"
        }
      },
      "money_tracker_incomes": {
        "ClusterId": "money_tracker",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "api/Income/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "investment": {
        "Destinations": {
          "base": {
            "Address": "http://localhost:8000/"
          }
        }
      },
      "money_tracker": {
        "Destinations": {
          "base": {
            "Address": "http://localhost:5079"
          }
        }
      }
    }
  }
}
